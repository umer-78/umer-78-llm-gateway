# Copy to .env.prod and fill in. Never commit the real file (it is in .gitignore by pattern).
#
#   cp deploy/.env.prod.example deploy/.env.prod

# Admin token for the gateway's management endpoints (chaos, model activate). Use a long random value.
GATEWAY_ADMIN_TOKEN=change-me-to-a-long-random-string

# Grafana admin password (login is required in production).
GRAFANA_ADMIN_PASSWORD=change-me

# Provider API keys — add the ones your config.yaml references, for example:
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk-...
# ANTHROPIC_API_KEY=sk-ant-...
